#!/usr/bin/python3 -I
"""llm-ctl: ai-panel's agent on the GPU host (Proxmox, llama.cpp in an LXC container).

The panel's SSH key may run this and nothing else (a forced command). It reads one verb from
SSH_ORIGINAL_COMMAND, checks it against fixed lists from its config, runs fixed commands
without a shell, answers one JSON object, and logs each call to syslog (tag llm-ctl).

    status                         host, guests, running tasks, the LLM's units and health
    shutdown | reboot              stop the LLM's container, then power off or reboot the host
    llm switch <model>             start that model's unit, stopping the others
    llm restart|stop|start         the active unit; all units; the default model's unit
    guest <id> start|shutdown|reboot
    probe                          read-only health: GPUs, the LLM, an optional probe command
    client-checks pause|resume     a client's checks of the LLM (user timers in a guest VM)

Run by the unprivileged account, it checks the verb and runs itself again through sudo with
the checked words as arguments; as root it checks them again and acts. As root it reads only
/etc/llm-ctl/config.toml, and only when root owns it and its folder and nobody else can write
them. One changing verb runs at a time (a lock), each within a time budget below the panel's
wait, and shutdown and reboot wait until the host has run a while (no reboot loops).

Standard library only; runs on the host's own Python (3.11 or newer, for tomllib).
"""

import fcntl
import json
import os
import re
import socket
import subprocess
import sys
import syslog
import threading
import time
import tomllib

CONFIG = "/etc/llm-ctl/config.toml"
SELF = "/usr/local/sbin/llm-ctl"
LOCK = "/run/llm-ctl.lock"
WORD = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$")
UNIT = re.compile(r"^[A-Za-z0-9][A-Za-z0-9@._-]{0,127}$")
EXIT_OK, EXIT_FAILED, EXIT_REFUSED = 0, 1, 2
OUTPUT_CAP = 1024 * 1024
CHILD_ENV = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LANG": "C.UTF-8"}
# Each verb finishes within its budget, which the panel's own wait must exceed (docs/agent.md).
BUDGETS = {"status": 20, "probe": 120}
DEFAULT_BUDGET = 240
CHANGING = ("shutdown", "reboot", "llm", "guest", "client-checks")

DEFAULT_COMMANDS = {
    "pct": ["/usr/sbin/pct"],
    "qm": ["/usr/sbin/qm"],
    "pvesh": ["/usr/bin/pvesh"],
    "sudo": ["/usr/bin/sudo", "-n"],
    "nvidia_smi": ["/usr/bin/nvidia-smi"],
    "poweroff": ["/usr/bin/systemctl", "poweroff"],
    "reboot": ["/usr/bin/systemctl", "reboot"],
    # These run inside the LLM's container, through `pct exec`.
    "ct_systemctl": ["/usr/bin/systemctl"],
    "ct_curl": ["/usr/bin/curl"],
    "ct_cat": ["/usr/bin/cat"],
    # These run inside the client's VM, through `qm guest exec`.
    "vm_systemctl": ["/usr/bin/systemctl"],
    "vm_systemd_run": ["/usr/bin/systemd-run"],
}
RESUME_UNIT = "llm-ctl-resume-checks"


class Refused(Exception):
    """The request is not one this agent accepts."""


class Failed(Exception):
    """The request was accepted, and did not work."""


class Result:
    def __init__(self, returncode, stdout="", stderr=""):
        self.returncode = returncode
        self.stdout = stdout
        self.stderr = stderr


def _drain(stream, sink):
    """Read a pipe to its end, keeping at most OUTPUT_CAP bytes."""
    kept = bytearray()
    for chunk in iter(lambda: stream.read(65536), b""):
        if len(kept) < OUTPUT_CAP:
            kept += chunk[: OUTPUT_CAP - len(kept)]
    sink.append(bytes(kept))


class Runner:
    """Runs a command as an argument list, never through a shell, with a fixed environment
    and no stdin unless given. Tests use a fake."""

    def run(self, argv, input=None, timeout=60):
        try:
            proc = subprocess.Popen(
                argv,
                stdin=subprocess.PIPE if input is not None else subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                env=CHILD_ENV,
            )
        except OSError as e:
            raise Failed("cannot run %s: %s" % (argv[0], e)) from None
        out, err = [], []
        readers = [
            threading.Thread(target=_drain, args=(proc.stdout, out), daemon=True),
            threading.Thread(target=_drain, args=(proc.stderr, err), daemon=True),
        ]
        for reader in readers:
            reader.start()
        if input is not None:
            try:
                proc.stdin.write(input.encode())
                proc.stdin.close()
            except OSError:
                pass
        try:
            proc.wait(timeout=timeout)
        except subprocess.TimeoutExpired:
            proc.kill()
            try:
                proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                pass  # unkillable (a hung disk): leave it, but do not hang with it
            raise Failed("%s did not finish within %d s" % (argv[0], timeout)) from None
        for reader in readers:
            reader.join(timeout=5)
        text = [b"".join(x).decode("utf-8", errors="replace") for x in (out, err)]
        return Result(proc.returncode, *text)


def _words(values, what, pattern=WORD):
    out = [str(v) for v in values]
    for v in out:
        if not pattern.match(v):
            raise ValueError("%s: %r is not allowed" % (what, v))
    return out


def _argv(value, what):
    if isinstance(value, str):
        value = [value]
    if not isinstance(value, list) or not value or not all(isinstance(v, str) for v in value):
        raise ValueError("%s must be a command: a list of strings" % what)
    if not value[0].startswith("/"):
        raise ValueError("%s must start with an absolute path, not %r" % (what, value[0]))
    return list(value)


def _short(value):
    """A short string from untrusted JSON, or None."""
    return value[:200] if isinstance(value, str) else None


class Config:
    def __init__(self, data):
        llm = data.get("llm") or {}
        if "ct" not in llm:
            raise ValueError("llm.ct (the LLM's container id) is required")
        self.ct = str(int(llm["ct"]))
        self.url = str(llm.get("url", "http://127.0.0.1:8080")).rstrip("/")
        self.api_key_file = llm.get("api_key_file")
        models = llm.get("models") or {}
        if not models:
            raise ValueError("llm.models needs at least one model")
        self.models = {}
        for name, model in models.items():
            _words([name], "model name")
            self.models[name] = _words([model["unit"]], "unit", UNIT)[0]
        self.default_model = llm.get("default_model", next(iter(self.models)))
        if self.default_model not in self.models:
            raise ValueError("llm.default_model is not one of llm.models")
        self.health_timeout = int(llm.get("health_timeout_seconds", 5))

        guests = data.get("guests") or {}
        self.guests = [int(g) for g in guests.get("allowed", [])]
        self.guest_timeout = int(guests.get("shutdown_timeout_seconds", 120))
        stop = data.get("shutdown") or {}
        self.llm_stop_timeout = int(stop.get("llm_timeout_seconds", 120))
        self.min_uptime = int(stop.get("min_uptime_minutes", 10)) * 60
        self.budget = int(data.get("limit_seconds", DEFAULT_BUDGET))
        self.node = str(data.get("node") or socket.gethostname().split(".")[0])
        self.lock = str(data.get("lock_file", LOCK))

        checks = data.get("client_checks")
        self.checks = None
        if checks:
            self.checks = {
                "vmid": str(int(checks["vmid"])),
                "pause": _argv(checks["pause"], "client_checks.pause"),
                "resume": _argv(checks["resume"], "client_checks.resume"),
                "auto_resume": int(checks.get("auto_resume_minutes", 60)),
            }
        probe = data.get("probe") or {}
        self.probe_command = (
            _argv(probe["command"], "probe.command") if "command" in probe else None
        )
        self.commands = dict(DEFAULT_COMMANDS)
        for key, value in (data.get("commands") or {}).items():
            if key not in DEFAULT_COMMANDS:
                raise ValueError("commands.%s is not a known command" % key)
            self.commands[key] = _argv(value, "commands." + key)
        self.self_path = str(data.get("self", SELF))


def check_owner(path, owner):
    """Root (`owner`) owns the config and its folder, and nobody else may write them: a
    config another user could change would be a way to run anything as root."""
    for p in (path, os.path.dirname(os.path.abspath(path))):
        st = os.stat(p)
        if st.st_uid != owner or st.st_mode & 0o022:
            raise ValueError("%s must be owned by uid %d and not group/world-writable" % (p, owner))


def load_config(path, owner=None):
    if owner is not None:
        check_owner(path, owner)
    with open(path, "rb") as f:
        return Config(tomllib.load(f))


def parse(words, config):
    """The checked verb as a tuple of words, or Refused."""
    if not words:
        raise Refused("no command given")
    for word in words:
        if not WORD.match(word):
            raise Refused("refused word %r" % word[:40])
    verb = tuple(words)
    if verb in (("status",), ("shutdown",), ("reboot",), ("probe",)):
        return verb
    if len(verb) == 3 and verb[:2] == ("llm", "switch"):
        if verb[2] not in config.models:
            raise Refused("unknown model %r" % verb[2])
        return verb
    if len(verb) == 2 and verb[0] == "llm" and verb[1] in ("restart", "stop", "start"):
        return verb
    if len(verb) == 3 and verb[0] == "guest" and verb[2] in ("start", "shutdown", "reboot"):
        if not verb[1].isdigit() or int(verb[1]) not in config.guests:
            raise Refused("guest %s is not allowed" % verb[1])
        return verb
    if len(verb) == 2 and verb[0] == "client-checks" and verb[1] in ("pause", "resume"):
        if config.checks is None:
            raise Refused("client-checks is not configured")
        return verb
    raise Refused("unknown command %r" % " ".join(words)[:80])


def _json(text):
    try:
        return json.loads(text or "null")
    except (ValueError, RecursionError):
        return None


class Agent:
    def __init__(self, config, runner, read_file=None, budget=DEFAULT_BUDGET):
        self.config = config
        self.runner = runner
        self.read_file = read_file or _read_file
        self.deadline = time.monotonic() + budget
        self.budget = budget
        self.after = None  # a command to run once the answer is out (power off, reboot)

    # helpers

    def cmd(self, name):
        return list(self.config.commands[name])

    def run(self, argv, input=None, timeout=60, check=True):
        left = self.deadline - time.monotonic()
        if left <= 1:
            raise Failed("took longer than its %d s budget" % self.budget)
        result = self.runner.run(argv, input=input, timeout=min(timeout, left))
        if check and result.returncode != 0:
            detail = (result.stderr or result.stdout).strip().splitlines()
            raise Failed(
                "%s: %s"
                % (
                    " ".join(argv[:4]),
                    detail[-1][:300] if detail else "exit %d" % result.returncode,
                )
            )
        return result

    def in_ct(self, name, *args, input=None, timeout=60, check=True):
        argv = [*self.cmd("pct"), "exec", self.config.ct, "--", *self.cmd(name), *list(args)]
        return self.run(argv, input=input, timeout=timeout, check=check)

    def in_vm(self, argv, check=True):
        vm = self.config.checks["vmid"]
        result = self.run(
            [*self.cmd("qm"), "guest", "exec", vm, "--timeout", "60", "--", *argv],
            timeout=90,
            check=check,
        )
        reply = _json(result.stdout)
        exitcode = int(reply.get("exitcode", 1)) if isinstance(reply, dict) else 1
        if check and exitcode != 0:
            raise Failed("%s: exit %d inside VM %s" % (argv[-1], exitcode, vm))
        return exitcode

    def pvesh(self, path, *args):
        argv = [*self.cmd("pvesh"), "get", path, *list(args), "--output-format", "json"]
        reply = _json(self.run(argv, timeout=15).stdout)
        if not isinstance(reply, list):
            raise Failed("pvesh %s: not a JSON list" % path)
        return [x for x in reply if isinstance(x, dict)]

    def guests(self):
        wanted = set(self.config.guests) | {int(self.config.ct)}
        found = []
        for kind in ("lxc", "qemu"):
            for g in self.pvesh("/nodes/%s/%s" % (self.config.node, kind)):
                if str(g.get("vmid", "")).isdigit() and int(g["vmid"]) in wanted:
                    found.append(
                        {
                            "id": int(g["vmid"]),
                            "name": _short(g.get("name")) or "",
                            "type": kind,
                            "status": _short(g.get("status")) or "unknown",
                        }
                    )
        return sorted(found, key=lambda g: g["id"])

    def guest_type(self, guest_id):
        for g in self.guests():
            if g["id"] == guest_id:
                return g["type"]
        raise Failed("guest %d does not exist on %s" % (guest_id, self.config.node))

    def units(self):
        """Each model's unit inside the container: {"active": ..., "load": ...}."""
        names = list(self.config.models)
        result = self.in_ct(
            "ct_systemctl",
            "show",
            "--property=LoadState,ActiveState",
            *[self.config.models[n] for n in names],
            timeout=15,
            check=False,
        )
        blocks = [b for b in result.stdout.strip().split("\n\n") if b.strip()]
        if len(blocks) != len(names):
            return {n: {"active": "unknown", "load": "unknown"} for n in names}
        out = {}
        for name, block in zip(names, blocks, strict=True):
            props = dict(line.partition("=")[::2] for line in block.splitlines())
            out[name] = {
                "active": props.get("ActiveState", "unknown")[:30],
                "load": props.get("LoadState", "unknown")[:30],
            }
        return out

    def active_model(self, units=None):
        units = units if units is not None else self.units()
        return next((n for n, u in units.items() if u["active"] == "active"), None)

    def http_code(self, path):
        result = self.in_ct(
            "ct_curl",
            "-s",
            "-o",
            "/dev/null",
            "-w",
            "%{http_code}",
            "-m",
            str(self.config.health_timeout),
            self.config.url + path,
            timeout=self.config.health_timeout + 5,
            check=False,
        )
        code = result.stdout.strip()
        return int(code) if code.isdigit() and code != "000" else None

    def props(self):
        """/props with the API key, kept off every command line: curl reads it on stdin."""
        headers = ""
        if self.config.api_key_file:
            key = self.in_ct("ct_cat", self.config.api_key_file, timeout=5).stdout.strip()
            headers = "Authorization: Bearer %s\n" % key
        result = self.in_ct(
            "ct_curl",
            "-s",
            "-m",
            str(self.config.health_timeout),
            "-H",
            "@-",
            self.config.url + "/props",
            input=headers,
            timeout=self.config.health_timeout + 5,
            check=False,
        )
        props = _json(result.stdout)
        if not isinstance(props, dict):
            return {}
        return {k: _short(props.get(k)) for k in ("model_alias", "model_path")}

    def llm_state(self):
        try:
            units = self.units()
        except Failed:
            units = {n: {"active": "unknown", "load": "unknown"} for n in self.config.models}
        state = {"active_model": self.active_model(units), "units": units, "health": None}
        try:
            state["health"] = self.http_code("/health")
            if state["health"] == 200:
                state.update(self.props())
        except Failed:
            pass
        return state

    def uptime(self):
        return int(float(self.read_file("/proc/uptime").split()[0]))

    # verbs

    def do_status(self):
        return {
            "host": {
                "hostname": socket.gethostname(),
                "uptime_seconds": self.uptime(),
                "kernel": os.uname().release,
                "boot_id": self.read_file("/proc/sys/kernel/random/boot_id").strip()[:64],
            },
            "guests": self.guests(),
            "tasks": [
                {
                    "type": _short(t.get("type")) or "",
                    "id": _short(t.get("id")) or "",
                    "user": _short(t.get("user")) or "",
                    "upid": _short(t.get("upid")) or "",
                }
                for t in self.pvesh("/nodes/%s/tasks" % self.config.node, "--source", "active")
            ],
            "llm": self.llm_state(),
        }

    def stop_llm_guest(self):
        up = self.uptime()
        if up < self.config.min_uptime:
            raise Failed(
                "the host started %d min ago: it must run %d min before a shutdown or reboot "
                "(shutdown.min_uptime_minutes)" % (up // 60, self.config.min_uptime // 60)
            )
        timeout = self.config.llm_stop_timeout
        result = self.run(
            [*self.cmd("pct"), "shutdown", self.config.ct, "--timeout", str(timeout)],
            timeout=timeout + 30,
            check=False,
        )
        if result.returncode != 0:
            state = self.run([*self.cmd("pct"), "status", self.config.ct], timeout=20, check=False)
            if "stopped" not in state.stdout:
                raise Failed(
                    "container %s did not stop: %s" % (self.config.ct, result.stderr.strip()[:300])
                )

    def do_shutdown(self):
        self.stop_llm_guest()
        self.after = self.cmd("poweroff")
        return {"llm_guest": "stopped", "host": "powering off"}

    def do_reboot(self):
        self.stop_llm_guest()
        self.after = self.cmd("reboot")
        return {"llm_guest": "stopped", "host": "rebooting"}

    def do_llm(self, op, model=None):
        units = self.config.models
        if op == "switch":
            unit = units[model]
            others = [u for u in units.values() if u != unit]
            if others:  # a failure here is checked below, after the start
                self.in_ct("ct_systemctl", "stop", *others, timeout=120, check=False)
            # A unit's start limit would make a quick switch back look like a broken config.
            self.in_ct("ct_systemctl", "reset-failed", *units.values(), timeout=15, check=False)
            self.in_ct("ct_systemctl", "start", unit, timeout=120)
            state = self.units()
            if state[model]["load"] != "loaded":
                raise Failed("unit %s is %s" % (unit, state[model]["load"]))
            still = [n for n, u in state.items() if n != model and u["active"] == "active"]
            if still:
                raise Failed("still running beside %s: %s" % (model, ", ".join(still)))
            return {"model": model, "unit": unit, "units": state}
        if op == "stop":
            self.in_ct("ct_systemctl", "stop", *units.values(), timeout=120)
            return {"stopped": list(units.values())}
        active = self.active_model()
        if op == "restart":
            if active is None:
                raise Failed("no model's unit is active")
            self.in_ct("ct_systemctl", "reset-failed", units[active], timeout=15, check=False)
            self.in_ct("ct_systemctl", "restart", units[active], timeout=120)
            return {"model": active, "unit": units[active]}
        if active is not None:
            return {"model": active, "unit": units[active], "note": "active already"}
        unit = units[self.config.default_model]
        self.in_ct("ct_systemctl", "reset-failed", unit, timeout=15, check=False)
        self.in_ct("ct_systemctl", "start", unit, timeout=120)
        return {"model": self.config.default_model, "unit": unit}

    def do_guest(self, guest_id, op):
        kind = self.guest_type(guest_id)
        tool = self.cmd("pct" if kind == "lxc" else "qm")
        argv = [*tool, op, str(guest_id)]
        timeout = self.config.guest_timeout
        if op in ("shutdown", "reboot"):
            argv += ["--timeout", str(timeout)]
        self.run(argv, timeout=timeout + 30)
        return {"id": guest_id, "type": kind, "op": op}

    def do_probe(self):
        reply = {"llm": self.llm_state(), "gpus": []}
        fields = ["index", "name", "temperature.gpu", "power.draw", "memory.used", "memory.total"]
        query = ["--query-gpu=" + ",".join(fields), "--format=csv,noheader,nounits"]
        result = self.run([*self.cmd("nvidia_smi"), *query], timeout=30, check=False)
        if result.returncode == 0:
            for line in result.stdout.strip().splitlines()[:16]:
                values = [v.strip()[:60] for v in line.split(",")]
                reply["gpus"].append(dict(zip(fields, values, strict=False)))
        else:
            reply["gpus_error"] = (result.stderr or result.stdout).strip()[-200:]
        if self.config.probe_command:
            probe = self.run(self.config.probe_command, timeout=90, check=False)
            lines = (probe.stdout + probe.stderr).strip().splitlines()[-40:]
            reply["probe"] = {"exit": probe.returncode, "output": [x[:300] for x in lines]}
        return reply

    def do_checks(self, op):
        """Pause or resume. A pause also schedules its own end inside the VM, so a resume the
        panel never sends cannot leave the checks off for good."""
        checks = self.config.checks
        stop_timer = [*self.cmd("vm_systemctl"), "stop", RESUME_UNIT + ".timer"]
        self.in_vm(stop_timer, check=False)
        self.in_vm(checks[op])
        reply = {"op": op, "vmid": int(checks["vmid"])}
        minutes = checks["auto_resume"]
        if op == "pause" and minutes > 0:
            timer = [
                *self.cmd("vm_systemd_run"),
                "--on-active=%dmin" % minutes,
                "--unit=" + RESUME_UNIT,
                "--collect",
                *checks["resume"],
            ]
            self.in_vm(timer)
            reply["auto_resume_minutes"] = minutes
        return reply

    def act(self, verb):
        match verb:
            case ("status",):
                return self.do_status()
            case ("shutdown",):
                return self.do_shutdown()
            case ("reboot",):
                return self.do_reboot()
            case ("probe",):
                return self.do_probe()
            case ("llm", "switch", model):
                return self.do_llm("switch", model)
            case ("llm", op):
                return self.do_llm(op)
            case ("guest", guest_id, op):
                return self.do_guest(int(guest_id), op)
            case ("client-checks", op):
                return self.do_checks(op)
        raise Refused("unknown command")


def _read_file(path):
    with open(path) as f:
        return f.read()


def _log(priority, message):
    syslog.openlog("llm-ctl", syslog.LOG_PID, syslog.LOG_DAEMON)
    syslog.syslog(priority, message)


def _emit(out, reply):
    """Answer. The panel may be gone already (a timeout, the host going down): that must never
    stop what comes after, such as the power off."""
    try:
        out.write(json.dumps(reply, separators=(",", ":")) + "\n")
        out.flush()
    except OSError:
        pass


def _lock(path):
    """One changing verb at a time, until it has answered and done what follows."""
    try:
        fd = os.open(path, os.O_WRONLY | os.O_CREAT, 0o600)
    except OSError as e:
        raise Failed("cannot open the lock %s: %s" % (path, e)) from None
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        os.close(fd)
        raise Failed("busy: another llm-ctl command is running") from None
    return fd


def main(
    argv=None,
    environ=None,
    runner=None,
    out=None,
    log=None,
    euid=None,
    execv=None,
    read_file=None,
    config_path=CONFIG,
    owner=0,
):
    environ = os.environ if environ is None else environ
    argv = sys.argv[1:] if argv is None else argv
    out = out or sys.stdout
    log = log or _log
    euid = os.geteuid() if euid is None else euid
    execv = execv or os.execv
    client = (environ.get("SSH_CLIENT") or "local").split()[0]
    original = environ.get("SSH_ORIGINAL_COMMAND")
    words = original.split() if original is not None else list(argv)
    shown = " ".join(words)[:120]

    try:
        config = load_config(config_path, owner)
    except (OSError, ValueError, KeyError, TypeError) as e:
        log(syslog.LOG_ERR, "config: %s" % e)
        _emit(out, {"ok": False, "error": "llm-ctl config: %s" % e})
        return EXIT_FAILED
    try:
        verb = parse(words, config)
    except Refused as e:
        log(syslog.LOG_WARNING, "refused %r from %s: %s" % (shown, client, e))
        _emit(out, {"ok": False, "error": str(e)})
        return EXIT_REFUSED

    if euid != 0:
        log(syslog.LOG_INFO, "%s from %s" % (" ".join(verb), client))
        sudo = config.commands["sudo"]
        execv(sudo[0], [*sudo, config.self_path, *list(verb)])
        return EXIT_FAILED  # only reached when execv is a test's fake

    budget = BUDGETS.get(verb[0], config.budget)
    agent = Agent(config, runner or Runner(), read_file, budget)
    try:
        lock = _lock(config.lock) if verb[0] in CHANGING else None
    except Failed as e:
        log(syslog.LOG_WARNING, "%s refused: %s" % (" ".join(verb), e))
        _emit(out, {"ok": False, "verb": " ".join(verb), "error": str(e)})
        return EXIT_FAILED
    try:
        return _act(agent, verb, out, log)
    finally:
        if lock is not None:
            os.close(lock)


def _act(agent, verb, out, log):
    try:
        reply = agent.act(verb)
    except Failed as e:
        log(syslog.LOG_ERR, "%s failed: %s" % (" ".join(verb), e))
        _emit(out, {"ok": False, "verb": " ".join(verb), "error": str(e)})
        return EXIT_FAILED
    # status runs every few seconds: logged at debug, the rest as notices
    log(syslog.LOG_DEBUG if verb == ("status",) else syslog.LOG_NOTICE, "%s: ok" % " ".join(verb))
    _emit(out, dict({"ok": True, "verb": " ".join(verb)}, **reply))
    if agent.after is not None:
        # The answer is out before the host goes down and takes the SSH session with it.
        try:
            result = agent.runner.run(agent.after, timeout=60)
        except Failed as e:
            log(syslog.LOG_ERR, "%s failed: %s" % (" ".join(agent.after), e))
            return EXIT_FAILED
        if result.returncode != 0:
            log(syslog.LOG_ERR, "%s failed: %s" % (" ".join(agent.after), result.stderr.strip()))
            return EXIT_FAILED
    return EXIT_OK


if __name__ == "__main__":
    sys.exit(main())
